classDiagram
  direction TB
  class Person {
    <<abstract>>
    -int id
    -String name
    -String phone
    -String email
    +getId() int
    +getName() String
    +getPhone() String
    +getEmail() String
    +setId(int)
    +setName(String)
    +setPhone(String)
    +setEmail(String)
  }
  class Client {
    -String type
    -String address
    +getType() String
    +getAddress() String
    +setType(String)
    +setAddress(String)
  }
  class DeliveryAgent {
    -String vehicleType
    -String vehicleNo
    +getVehicleType() String
    +getVehicleNo() String
    +setVehicleType(String)
    +setVehicleNo(String)
  }
  class BaseDAO~T extends Person~ {
    <<abstract>>
    #List~T~ list
    -File file
    #toLine(T) String
    #fromLine(String[]) T
    +getAll() List~T~
    +add(T)
    +update(T)
    +remove(int)
    +findById(int) T
    -load()
    -save()
  }
  class ClientDAO {
    #toLine(Client) String
    #fromLine(String[]) Client
  }
  class DeliveryAgentDAO {
    #toLine(DeliveryAgent) String
    #fromLine(String[]) DeliveryAgent
  }
  class Validator {
    +check(name, phone, email, others) String$
  }
  class ClientPanel {
    -ClientDAO dao
    -JTable table
    -addClient()
    -updateClient()
    -removeClient()
    -refresh()
  }
  class DeliveryAgentPanel {
    -DeliveryAgentDAO dao
    -JTable table
    -addAgent()
    -updateAgent()
    -removeAgent()
    -refresh()
  }
  Person <|-- Client
  Person <|-- DeliveryAgent
  BaseDAO <|-- ClientDAO
  BaseDAO <|-- DeliveryAgentDAO
  ClientDAO ..> Client : manages
  DeliveryAgentDAO ..> DeliveryAgent : manages
  ClientPanel --> ClientDAO : uses
  DeliveryAgentPanel --> DeliveryAgentDAO : uses
  ClientPanel ..> Validator
  DeliveryAgentPanel ..> Validator
